{
  "name": "@zedings/agent-session",
  "version": "0.3.0",
  "description": "Local-first AI agent session archive with a unified JSONL schema and pluggable adapters",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "agent-session": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "docs",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "schema": "npm run build && node scripts/schema.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "agent",
    "session",
    "jsonl",
    "deepseek",
    "cli",
    "local-first"
  ],
  "author": "Zeding Zhang",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZedingZhang/agent-session.git"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
